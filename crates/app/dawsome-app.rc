// dawsome-app.exe's resources, compiled by build.rs, which defines VERSION (the text) and
// VERSION_MAJOR, VERSION_MINOR and VERSION_PATCH (the numbers) from Cargo.toml. No header is
// included, so constants are written as numbers. File paths are relative to this folder, where
// the resource compiler runs.

// Explorer and the taskbar show the icon with the lowest number. scripts/make-ico.py makes it
// from the icon's PNGs.
1 ICON "../../assets/icon/dawsome.ico"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEOS 0x40004 // VOS_NT_WINDOWS32
FILETYPE 0x1 // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English (0409) in Unicode (04B0), as the translation below says.
        BLOCK "040904B0"
        BEGIN
            // Task Manager names the running program by its description.
            VALUE "FileDescription", "Dawsome"
            VALUE "FileVersion", VERSION
            VALUE "InternalName", "dawsome-app"
            VALUE "OriginalFilename", "dawsome-app.exe"
            VALUE "ProductName", "Dawsome"
            VALUE "ProductVersion", VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
